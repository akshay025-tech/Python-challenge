#Alphabet Triangle
n=7
for i in range(1,n+1):
  for j in range(i):
    print(chr(65+j), end=" ")  
  print()  

#Aplhabet repeating
n=7
for i in range(1,n+1):
  for j in range(i):
    print(chr(65+i-1), end=" ")  
  print()  

#Inverted Aplhabet
n=7
for i in range(n,0,-1):
  for j in range(i):
    print(chr(65+j), end=" ")  
  print()  

#flyods Alphabet triangle
n=6
char=65
for i in range(1,n+1):
  for j in range(i):
    print(chr(char), end=" ") 
    char+=1
  print()  
