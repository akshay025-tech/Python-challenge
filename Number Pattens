#Increasinbg Numbers
n=7
for i in range(1,n+1):
  for j in range(1,i+1):
    print(j, end=" ")
  print()  

#Repeated Numbers
n=7
for i in range(1,n+1):
  for j in range(1,i+1):
    print(i, end=" ")
  print()  

#Floyd's Triangle
n=7
num=1
for i in range(1,n+1):
  for j in range(i):
    print(num, end=" ")
    num+=1
  print()  

