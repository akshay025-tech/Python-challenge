# square pattern
n=3
for i in range(n):
  for j in range(n):
    print("*", end=" ")
  print()  


#right angle pattern
n=7
for i in range(1,n+1):
  for j in range(i):
    print("*", end=" ")
  print()  

 #inverted triangle
 n=7
for i in range(n,0,-1):
  for j in range(i):
    print("*", end=" ")
  print()  

#pyramid triangle
n=7
for i in range(1,n+1):
  for j in range(n-i):
    print(" ", end=" ")
  for j in range(2*i-1):
    print("*", end=" ")
  print()  

  
